{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Kelvra: Install Extension Dependencies",
      "type": "shell",
      "command": "npm ci && npm run compile",
      "options": { "cwd": "${workspaceFolder}/tooling/vscode-kelvra" },
      "problemMatcher": []
    },
    {
      "label": "Kelvra: Configure Tooling Debug Build",
      "type": "shell",
      "command": "bash scripts/configure_tooling_build.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Kelvra: Build Language Server",
      "type": "shell",
      "command": "cmake --build build/tooling-debug --target kelvra-lsp --parallel",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Kelvra: Configure Tooling Debug Build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Kelvra: Prepare Tooling Development",
      "dependsOn": [
        "Kelvra: Install Extension Dependencies",
        "Kelvra: Build Language Server"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Kelvra: Run LSP Tests",
      "type": "shell",
      "command": "npm run test:lsp",
      "options": {
        "cwd": "${workspaceFolder}/tooling/vscode-kelvra",
        "env": { "KELVRA_LSP_PATH": "${workspaceFolder}/build/tooling-debug" }
      },
      "dependsOn": [
        "Kelvra: Install Extension Dependencies",
        "Kelvra: Build Language Server"
      ],
      "problemMatcher": []
    },
    {
      "label": "Kelvra: Package Development VSIX",
      "type": "shell",
      "command": "bash scripts/package_development_vsix.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": [
        "Kelvra: Install Extension Dependencies",
        "Kelvra: Build Language Server"
      ],
      "problemMatcher": []
    }
  ]
}
